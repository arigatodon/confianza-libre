<%# locals: territory %>
<% fund = territory.community_account&.cached_balance.to_i %>
<%= link_to territory_path(territory.slug),
      class: "block rounded-xl border border-outline-variant/30 bg-surface-container-lowest p-5 ambient-shadow hover:bg-surface-container transition-colors" do %>
  <header class="flex items-start justify-between gap-2 mb-3">
    <div class="min-w-0">
      <h3 class="text-headline-md text-on-surface truncate"><%= territory.name %></h3>
      <p class="text-caption text-on-surface-variant truncate">
        <%= [ territory.admin1, territory.country_code ].compact.join(" · ") %>
      </p>
    </div>
    <span class="material-symbols-outlined icon-filled text-primary shrink-0" style="font-size:22px">volunteer_activism</span>
  </header>

  <div class="flex items-baseline gap-1">
    <span class="text-headline-md text-primary font-bold"><%= number_with_delimiter(fund) %></span>
    <span class="text-caption text-on-surface-variant">C en el fondo</span>
  </div>
<% end %>
