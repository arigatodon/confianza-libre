<%# Reputación como proveedor y como cliente. La plantilla de la vitrina
    decide si esto va antes o después de las publicaciones. %>
<% if @full_view && @provider_breakdown.any? %>
  <section class="rounded-xl bg-surface-container-lowest border border-outline-variant/30 ambient-shadow p-5 space-y-4">
    <h2 class="text-label-md text-on-surface uppercase tracking-wider flex items-center gap-1">
      <span class="material-symbols-outlined icon-filled text-primary" style="font-size:16px">work</span>
      Reputación como proveedor
    </h2>
    <ul class="space-y-3">
      <% @provider_breakdown.each do |row| %>
        <% pct = (row.avg_score.to_f * 20).clamp(0, 100) %>
        <li class="space-y-1">
          <div class="flex items-center justify-between text-body-md">
            <span class="text-on-surface"><%= row.name %></span>
            <span class="text-on-surface-variant flex items-center gap-1">
              <span class="material-symbols-outlined icon-filled text-earth-clay" style="font-size:14px">star</span>
              <%= row.avg_score.to_f.round(2) %>
              <span class="text-caption">(<%= row.count %>)</span>
            </span>
          </div>
          <div class="h-1.5 w-full rounded-full bg-surface-container-high overflow-hidden">
            <div class="h-full bg-primary rounded-full" style="width: <%= pct %>%"></div>
          </div>
        </li>
      <% end %>
    </ul>
  </section>
<% end %>

<% if @full_view && @client_breakdown %>
  <% pct = (@client_breakdown.avg_score.to_f * 20).clamp(0, 100) %>
  <section class="rounded-xl bg-surface-container-lowest border border-outline-variant/30 ambient-shadow p-5 space-y-3">
    <h2 class="text-label-md text-on-surface uppercase tracking-wider flex items-center gap-1">
      <span class="material-symbols-outlined icon-filled text-soft-sky" style="font-size:16px">shopping_bag</span>
      Reputación como cliente
    </h2>
    <div class="flex items-center justify-between text-body-md">
      <span class="text-on-surface-variant text-caption">
        Cómo te evalúan quienes te ofrecieron sus servicios.
      </span>
      <span class="text-on-surface flex items-center gap-1 shrink-0">
        <span class="material-symbols-outlined icon-filled text-earth-clay" style="font-size:14px">star</span>
        <strong><%= @client_breakdown.avg_score.to_f.round(2) %></strong>
        <span class="text-caption text-on-surface-variant">(<%= @client_breakdown.count %>)</span>
      </span>
    </div>
    <div class="h-1.5 w-full rounded-full bg-surface-container-high overflow-hidden">
      <div class="h-full bg-soft-sky rounded-full" style="width: <%= pct %>%"></div>
    </div>
  </section>
<% end %>
