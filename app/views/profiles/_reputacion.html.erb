<%# Reputación como proveedor y como cliente. La plantilla de la vitrina
    decide si esto va antes o después de las publicaciones. %>
<% if @full_view && @provider_breakdown.any? %>
  <section class="rounded-xl bg-surface-container-lowest border border-outline-variant/30 ambient-shadow p-5 space-y-4">
    <h2 class="text-label-md text-on-surface flex items-center gap-1.5">
      <span class="material-symbols-outlined icon-filled text-primary" style="font-size:18px">work</span>
      Cuando ofrece algo
    </h2>
    <ul class="space-y-3">
      <% @provider_breakdown.each do |row| %>
        <li class="flex flex-wrap items-center justify-between gap-2 text-body-md">
          <span class="text-on-surface"><%= row.name %></span>
          <span class="flex items-center gap-2">
            <%= estrellas(row.avg_score) %>
            <span class="text-caption text-on-surface-variant"><%= contar(row.count, "reseña") %></span>
          </span>
        </li>
      <% end %>
    </ul>
  </section>
<% end %>

<% if @full_view && @client_breakdown %>
  <section class="rounded-xl bg-surface-container-lowest border border-outline-variant/30 ambient-shadow p-5 space-y-3">
    <h2 class="text-label-md text-on-surface flex items-center gap-1.5">
      <span class="material-symbols-outlined icon-filled text-secondary" style="font-size:18px">shopping_bag</span>
      Cuando pide algo
    </h2>
    <div class="flex flex-wrap items-center justify-between gap-2 text-body-md">
      <span class="text-on-surface-variant">Lo que dicen quienes le ofrecieron algo.</span>
      <span class="flex items-center gap-2 shrink-0">
        <%= estrellas(@client_breakdown.avg_score) %>
        <span class="text-caption text-on-surface-variant"><%= contar(@client_breakdown.count, "reseña") %></span>
      </span>
    </div>
  </section>
<% end %>
