<%# locals: post, interaction, reviewed_user, review %>
<%= form_with model: review, url: post_reviews_path(post), class: "space-y-3 rounded-xl border border-outline-variant/30 bg-surface-container-lowest p-4 ambient-shadow" do |f| %>
  <% if review.errors.any? %>
    <div class="rounded-lg bg-error-container border border-error/30 text-on-error-container px-3 py-2 text-xs">
      <%= review.errors.full_messages.to_sentence %>
    </div>
  <% end %>

  <%= f.hidden_field :interaction_id, value: interaction.id %>

  <fieldset>
    <legend class="block text-label-md text-on-surface mb-2">¿Cuántas estrellas le das a @<%= reviewed_user.username || reviewed_user.email_address %>?</legend>
    <div class="flex gap-2 flex-wrap">
      <% (1..5).each do |n| %>
        <label class="flex items-center gap-1.5 cursor-pointer text-body-md text-on-surface px-3 min-h-11 rounded-full border border-outline-variant has-[:checked]:border-2 has-[:checked]:border-secondary has-[:checked]:bg-secondary-fixed/60 transition-colors">
          <%= f.radio_button :score, n, checked: review.score == n %>
          <span class="text-secondary" aria-hidden="true"><%= "★" * n %></span>
          <span class="sr-only"><%= n %> <%= n == 1 ? "estrella" : "estrellas" %></span>
        </label>
      <% end %>
    </div>
  </fieldset>

  <% if post.category.max_credit_multiplier.to_f > 0.2 %>
    <div>
      <%= f.label :comment, "Cuéntalo en una frase (opcional)", class: "block text-label-md text-on-surface mb-1" %>
      <%= f.text_area :comment, rows: 2, placeholder: "Ej: Llegó a la hora y quedó perfecto." %>
    </div>
  <% end %>

  <div class="flex justify-end">
    <%= f.submit "Enviar reseña",
          class: "inline-flex items-center gap-1.5 px-6 min-h-12 rounded-full bg-primary text-on-primary text-label-md hover:bg-primary-strong cursor-pointer" %>
  </div>
<% end %>
