<article id="<%= dom_id(review) %>" class="rounded-xl border border-outline-variant/30 bg-surface-container-lowest p-4 ambient-shadow">
  <header class="flex items-center justify-between gap-2 text-caption">
    <%= link_to profile_path(review.reviewer.username || review.reviewer.id),
          class: "flex items-center gap-2 group min-w-0" do %>
      <% if review.reviewer.avatar.attached? && review.reviewer.avatar.image? %>
        <%= image_tag review.reviewer.avatar, class: "w-7 h-7 rounded-full object-cover border border-outline-variant" %>
      <% else %>
        <span class="w-7 h-7 rounded-full bg-primary-fixed text-on-primary-fixed grid place-items-center text-xs font-semibold">
          <%= (review.reviewer.username || review.reviewer.email_address).first.upcase %>
        </span>
      <% end %>
      <span class="text-primary font-semibold truncate group-hover:underline">
        @<%= review.reviewer.username || review.reviewer.email_address %>
      </span>
    <% end %>
    <span class="text-secondary flex items-center" aria-label="Puntaje">
      <% review.score.times do %><span class="material-symbols-outlined icon-filled" style="font-size:14px">star</span><% end %>
      <% (5 - review.score).times do %><span class="material-symbols-outlined text-outline-variant" style="font-size:14px">star</span><% end %>
    </span>
  </header>
  <% if review.comment.present? %>
    <p class="mt-3 text-body-md text-on-surface whitespace-pre-wrap"><%= review.comment %></p>
  <% end %>
  <p class="mt-3 text-caption text-on-surface-variant flex items-center gap-1">
    <span class="material-symbols-outlined" style="font-size:12px">schedule</span>
    <%= time_ago_in_words(review.created_at) %>
  </p>
</article>
