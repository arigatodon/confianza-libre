<%# locals: conversation %>
<%= form_with model: [ conversation, DirectMessage.new ],
      id: "dm-form-#{conversation.id}",
      class: "flex items-stretch gap-2",
      data: { controller: "auto-focus" } do |f| %>
  <%= f.text_field :body,
        required: true,
        autocomplete: "off",
        placeholder: "Escribe un mensaje…",
        class: "flex-1",
        data: { auto_focus_target: "field" } %>
  <%= f.submit "Enviar",
        class: "inline-flex items-center gap-1.5 px-4 py-2 rounded-full bg-primary text-on-primary text-label-md hover:bg-organic-green-deep transition-colors cursor-pointer" %>
<% end %>
