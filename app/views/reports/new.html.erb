<% content_for :title, "Reportar contenido" %>

<%
  back_path =
    case @reportable
    when Post    then post_path(@reportable)
    when Comment then post_path(@reportable.post)
    when Message then interaction_path(@reportable.interaction)
    when User    then profile_path(@reportable.username || @reportable.id)
    else root_path
    end
  kind_es = case @reportable.class.name
            when "Post"    then "publicación"
            when "Comment" then "comentario"
            when "Message" then "mensaje"
            when "User"    then "cuenta"
            else "contenido"
            end
%>

<article class="max-w-xl mx-auto space-y-6">
  <header class="space-y-1">
    <div class="text-caption text-on-surface-variant flex items-center gap-2">
      <%= link_to "Volver", back_path, class: "hover:text-primary" %>
    </div>
    <h1 class="text-headline-lg-mobile md:text-headline-lg text-on-surface">Reportar <%= kind_es %></h1>
    <p class="text-body-md text-on-surface-variant">Lo revisa alguien de moderación de la comunidad.</p>
  </header>

  <%= form_with model: @report, url: reports_path, scope: :report,
        class: "space-y-4 rounded-xl bg-surface-container-lowest border border-outline-variant/30 p-5 ambient-shadow" do |f| %>
    <%= f.hidden_field :reportable_type, value: @reportable.class.name %>
    <%= f.hidden_field :reportable_id,   value: @reportable.id %>

    <div>
      <label class="block text-label-md text-on-surface mb-1">Motivo</label>
      <%= f.select :reason,
            Report::REASONS.keys.map { |k| [ Report::REASON_LABELS_ES[k.to_s] || k.to_s.humanize, k ] },
            { include_blank: "Elige un motivo" },
            { required: true, class: "w-full px-3 py-2 rounded-lg bg-surface-container-lowest border border-outline-variant/30 text-on-surface" } %>
    </div>

    <div>
      <label class="block text-label-md text-on-surface mb-1">Detalle (opcional)</label>
      <%= f.text_area :body, rows: 4, maxlength: 2000,
            placeholder: "Cuenta brevemente qué pasa.",
            class: "w-full px-3 py-2 rounded-lg bg-surface-container-lowest border border-outline-variant/30 text-on-surface" %>
    </div>

    <div class="flex items-center justify-end gap-2">
      <%= link_to "Cancelar", back_path,
            class: "px-3 py-1.5 rounded-full text-label-md text-on-surface-variant hover:bg-surface-container" %>
      <%= f.submit "Enviar reporte",
            class: "inline-flex items-center gap-1.5 px-4 py-2 rounded-full bg-error text-on-error text-label-md hover:bg-red-700 cursor-pointer" %>
    </div>
  <% end %>
</article>
