<%# locals: proposal %>
<%
  status_color = case proposal.status
                 when "open"     then "bg-primary-container/20 text-primary"
                 when "passed"   then "bg-primary text-on-primary"
                 when "executed" then "bg-organic-green-deep text-on-primary"
                 when "failed"   then "bg-error-container text-on-error-container"
                 when "canceled" then "bg-surface-container text-on-surface-variant"
                 end
%>
<%= link_to proposal_path(proposal),
      class: "block rounded-xl border border-outline-variant/30 bg-surface-container-lowest p-4 ambient-shadow hover:bg-surface-container transition-colors" do %>
  <header class="flex items-start justify-between gap-2 mb-2">
    <h3 class="text-label-md text-on-surface flex-1 min-w-0 leading-snug">
      <%= proposal.title %>
    </h3>
    <span class="text-caption font-semibold px-2.5 py-0.5 rounded-full <%= status_color %> shrink-0">
      <%= proposal.status_label_es %>
    </span>
  </header>

  <div class="flex items-center justify-between text-caption text-on-surface-variant">
    <% if proposal.fund_transfer? %>
      <span class="flex items-center gap-1">
        <span class="material-symbols-outlined" style="font-size:14px">person</span>
        @<%= proposal.proposer.username %> → @<%= proposal.beneficiary.username %>
      </span>
      <span class="flex items-center gap-1 text-primary font-semibold">
        <span class="material-symbols-outlined icon-filled" style="font-size:14px">payments</span>
        <%= number_with_delimiter(proposal.amount) %> C
      </span>
    <% elsif proposal.new_category? %>
      <span class="flex items-center gap-1">
        <span class="material-symbols-outlined" style="font-size:14px">person</span>
        @<%= proposal.proposer.username %>
      </span>
      <span class="flex items-center gap-1 text-primary font-semibold">
        <span class="material-symbols-outlined" style="font-size:14px">category</span>
        <%= proposal.category_name %>
      </span>
    <% else %>
      <span class="flex items-center gap-1">
        <span class="material-symbols-outlined" style="font-size:14px">person</span>
        @<%= proposal.proposer.username %>
      </span>
      <span class="flex items-center gap-1 text-primary font-semibold">
        <span class="material-symbols-outlined" style="font-size:14px">balance</span>
        <%= proposal.governable_parameter&.dig(:label) || proposal.parameter_key %> → <%= proposal.parameter_value %>
      </span>
    <% end %>
  </div>

  <% if proposal.open? %>
    <div class="mt-3 flex items-center gap-2 text-caption text-on-surface-variant">
      <span class="material-symbols-outlined" style="font-size:14px">how_to_vote</span>
      <%= proposal.yes_votes %> a favor · <%= proposal.no_votes %> en contra
      · cierra <%= time_ago_in_words(proposal.voting_closes_at) %>
    </div>
  <% elsif proposal.passed? || proposal.executed? %>
    <div class="mt-3 flex items-center gap-2 text-caption text-primary font-semibold">
      <span class="material-symbols-outlined icon-filled" style="font-size:14px">check_circle</span>
      <%= proposal.yes_votes %> de <%= proposal.total_votes %> votos (<%= number_with_precision(proposal.majority_pct, precision: 0) %>%)
    </div>
  <% end %>
<% end %>
