<%# Botón CTA "a prueba de balas" para emails. Locals: url, label. %>
<table role="presentation" cellpadding="0" cellspacing="0" style="margin:24px 0;">
  <tr>
    <td align="center" style="border-radius:10px; background-color:#0f5238;">
      <a href="<%= url %>" style="display:inline-block; padding:14px 30px; font-size:16px; font-weight:600; color:#ffffff; text-decoration:none; border-radius:10px;">
        <%= label %>
      </a>
    </td>
  </tr>
</table>
