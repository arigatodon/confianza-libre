<%# Botones "Continuar con Google / Microsoft". Solo los proveedores con
    credenciales configuradas. En la app Android no se muestran: Google no
    permite su login dentro de un WebView (hay que abrirlo en el navegador). %>
<%# separador: texto de la línea divisoria. separador_abajo: true la pone
    después de los botones (registro: botones primero, "o crea tu cuenta con
    email", formulario). %>
<% proveedores = Oauth::Proveedor.configurados %>
<% separador_abajo = local_assigns.fetch(:separador_abajo, false) %>
<% if proveedores.any? && !hotwire_native_app? %>
  <% divisor = capture do %>
    <div class="flex items-center gap-3 text-caption text-on-surface-variant">
      <span class="h-px flex-1 bg-outline-variant/40"></span>
      <span><%= local_assigns.fetch(:separador, "o continúa con") %></span>
      <span class="h-px flex-1 bg-outline-variant/40"></span>
    </div>
  <% end %>
  <div class="space-y-3">
    <%= divisor unless separador_abajo %>
    <div class="grid gap-2">
      <% proveedores.each do |p| %>
        <%= link_to oauth_start_path(p.nombre), data: { turbo: false },
              class: "inline-flex items-center justify-center gap-3 w-full px-5 py-2.5 rounded-full border border-outline-variant/60 bg-surface text-on-surface text-label-md hover:bg-surface-container transition-colors" do %>
          <% if p.nombre == "google" %>
            <svg width="18" height="18" viewBox="0 0 48 48" aria-hidden="true"><path fill="#EA4335" d="M24 9.5c3.5 0 6.6 1.2 9 3.5l6.7-6.7C35.6 2.6 30.2 0 24 0 14.6 0 6.5 5.4 2.6 13.3l7.8 6C12.3 13.6 17.7 9.5 24 9.5z"/><path fill="#4285F4" d="M46.5 24.5c0-1.6-.1-3.1-.4-4.5H24v9h12.7c-.6 3-2.3 5.5-4.8 7.2l7.5 5.8c4.4-4 7.1-10 7.1-17.5z"/><path fill="#FBBC05" d="M10.4 28.7A14.5 14.5 0 0 1 9.5 24c0-1.6.3-3.2.8-4.7l-7.8-6A24 24 0 0 0 0 24c0 3.9.9 7.5 2.6 10.7l7.8-6z"/><path fill="#34A853" d="M24 48c6.2 0 11.6-2 15.4-5.6l-7.5-5.8c-2.1 1.4-4.8 2.3-7.9 2.3-6.3 0-11.7-4.1-13.6-9.8l-7.8 6C6.5 42.6 14.6 48 24 48z"/></svg>
            Continuar con Google
          <% else %>
            <svg width="18" height="18" viewBox="0 0 23 23" aria-hidden="true"><rect x="1" y="1" width="10" height="10" fill="#F25022"/><rect x="12" y="1" width="10" height="10" fill="#7FBA00"/><rect x="1" y="12" width="10" height="10" fill="#00A4EF"/><rect x="12" y="12" width="10" height="10" fill="#FFB900"/></svg>
            Continuar con Microsoft (Hotmail / Outlook)
          <% end %>
        <% end %>
      <% end %>
    </div>
    <%= divisor if separador_abajo %>
  </div>
<% end %>
