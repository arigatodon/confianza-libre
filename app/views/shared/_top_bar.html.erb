<%# Top App Bar — sólo móvil (en desktop se usa la side nav) %>
<header class="md:hidden fixed top-0 inset-x-0 z-30 bg-surface/90 backdrop-blur border-b border-outline-variant/40">
  <div class="h-14 px-margin-mobile flex items-center justify-between">
    <%= link_to root_path, class: "flex items-center gap-2" do %>
      <span class="w-8 h-8 rounded-md bg-primary text-on-primary grid place-items-center">
        <span class="material-symbols-outlined icon-filled" style="font-size:18px">handshake</span>
      </span>
      <span class="text-headline-md text-primary font-bold leading-none">Confianza</span>
    <% end %>

    <div class="flex items-center gap-1 text-on-surface-variant">
      <% if authenticated? && (u = Current.session.user) %>
        <%= link_to notifications_path,
              class: "relative p-2 rounded-full hover:bg-surface-container-low transition-colors",
              title: "Notificaciones" do %>
          <span class="material-symbols-outlined <%= 'icon-filled' if unread_notifications_count.positive? %>" style="font-size:22px">notifications</span>
          <%= render "shared/bell_badge_top", count: unread_notifications_count %>
        <% end %>
        <%= link_to settings_path,
              class: "p-2 rounded-full hover:bg-surface-container-low transition-colors",
              title: "Ajustes" do %>
          <span class="material-symbols-outlined" style="font-size:22px">settings</span>
        <% end %>
        <%= link_to profile_path(u.username || u.id),
              class: "ml-1 flex items-center" do %>
          <% if u.avatar.attached? && u.avatar.image? %>
            <%= image_tag u.avatar, class: "w-9 h-9 rounded-full object-cover border border-outline-variant" %>
          <% else %>
            <span class="w-9 h-9 rounded-full bg-primary-container text-on-primary-container grid place-items-center text-sm font-semibold">
              <%= (u.username || u.email_address).first.upcase %>
            </span>
          <% end %>
        <% end %>
      <% else %>
        <%= link_to "Entrar", new_session_path,
              class: "text-label-md text-primary px-3 py-1.5 rounded-full hover:bg-surface-container-low" %>
        <%= link_to "Regístrate", signup_path,
              class: "text-label-md bg-primary text-on-primary px-3 py-1.5 rounded-full hover:bg-organic-green-deep transition-colors" %>
      <% end %>
    </div>
  </div>
</header>
