<%# Botón flotante de feedback. Visible en desktop (md+) abajo-derecha,
    fuera del path de moderación/feedback para no estorbar al moderador.
    En mobile se evita porque el bottom nav + FAB ya ocupan ese espacio. %>
<% unless request.path.start_with?("/feedback", "/moderacion") %>
  <div class="hidden md:block fixed bottom-6 right-6 z-40">
    <%= link_to new_feedback_path,
          class: "group inline-flex items-center gap-2.5 pl-3 pr-4 py-2 rounded-xl bg-surface-container-lowest border border-outline-variant text-on-surface text-label-md ambient-shadow-lg hover:border-primary transition-colors" do %>
      <span class="w-8 h-8 rounded-md bg-signal text-ink grid place-items-center">
        <span class="material-symbols-outlined icon-filled" style="font-size:18px">campaign</span>
      </span>
      <span class="flex flex-col leading-tight">
        <span class="text-rotulo text-on-surface-variant" style="font-size:10px">Beta</span>
        <span>Mándanos tu opinión</span>
      </span>
    <% end %>
  </div>
<% end %>
