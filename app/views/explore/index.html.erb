<% content_for :title, "Explorar" %>
<% content_for :head do %>
  <%= seo_meta_tags(
        title:       "Explorar cerca",
        description: "Descubre en el mapa lo que pasa en tu comunidad: ventas, servicios, delivery, eventos y pedidos de ayuda cerca de ti.",
        canonical:   explore_url) %>
<% end %>

<section class="space-y-6">
  <div class="flex flex-col gap-1">
    <p class="text-caption text-on-surface-variant uppercase tracking-wider">Mapa comunitario</p>
    <h1 class="text-headline-lg-mobile md:text-headline-lg text-on-surface">Explorar cerca</h1>
    <p class="text-body-md text-on-surface-variant">Toca un marcador para ver la publicación.</p>
  </div>

  <%# Buscador + filtros colapsados: al entrar a Explorar se ve el mapa
      enseguida y los filtros se despliegan con un toque. Quedan abiertos si
      llegas con filtros activos (p. ej. desde una URL compartida o una alerta).
      El form es GET y vive fuera del turbo-frame de resultados para que los
      inputs no se pisen al reemplazar la lista; el submit lo targetea y hace
      advance de la URL (filtros compartibles / navegables). %>
  <% active_filters = [ @filters[:q], @filters[:category_id], @filters[:kind],
                        @filters[:market], @filters[:credits_max] ].count(&:present?)
     active_filters += 1 if @filters[:radius_km] != ExploreController::DEFAULT_RADIUS_KM %>
  <details class="map-filters rounded-xl bg-surface-container-lowest border border-outline-variant/30 ambient-shadow"
           <%= "open" if active_filters.positive? %>>
    <summary class="flex items-center justify-between gap-2 p-4 cursor-pointer select-none list-none">
      <span class="inline-flex items-center gap-2 text-label-md text-on-surface">
        <span class="material-symbols-outlined text-primary" style="font-size:20px">search</span>
        Buscar y filtrar
        <% if active_filters.positive? %>
          <span class="inline-flex items-center justify-center min-w-[1.25rem] h-5 px-1.5 rounded-full bg-primary text-on-primary text-caption"><%= active_filters %></span>
        <% end %>
      </span>
      <span class="material-symbols-outlined map-filters-chevron text-on-surface-variant transition-transform" style="font-size:20px">expand_more</span>
    </summary>

    <%= form_with url: explore_path, method: :get, scope: nil,
          data: { turbo_frame: "explore-results", turbo_action: "advance",
                  controller: "auto-submit" },
          class: "px-4 pb-4 pt-4 border-t border-outline-variant/20" do %>
    <div class="grid grid-cols-1 md:grid-cols-12 gap-3 items-end">
      <div class="md:col-span-4">
        <label class="block text-label-md text-on-surface mb-1" for="filter-q">Buscar</label>
        <div class="relative">
          <span class="material-symbols-outlined absolute left-2 top-1/2 -translate-y-1/2 text-on-surface-variant pointer-events-none" style="font-size:18px">search</span>
          <input id="filter-q" type="search" name="q" value="<%= @filters[:q] %>"
                 placeholder="Título o descripción…"
                 class="w-full pl-9 pr-3 py-2 rounded-lg bg-surface-container-lowest border border-outline-variant/30 text-on-surface placeholder:text-on-surface-variant focus:outline-none focus:border-primary">
        </div>
      </div>

      <div class="md:col-span-3">
        <label class="block text-label-md text-on-surface mb-1" for="filter-category">Categoría</label>
        <select id="filter-category" name="category_id"
                data-action="change->auto-submit#submit"
                class="w-full px-3 py-2 rounded-lg bg-surface-container-lowest border border-outline-variant/30 text-on-surface">
          <option value="">Todas</option>
          <% @categories.each do |c| %>
            <option value="<%= c.id %>" <%= "selected" if @filters[:category_id].to_s == c.id.to_s %>><%= c.name %></option>
          <% end %>
        </select>
      </div>

      <div class="md:col-span-2">
        <label class="block text-label-md text-on-surface mb-1" for="filter-market">Ofertas / Pedidos</label>
        <select id="filter-market" name="market"
                data-action="change->auto-submit#submit"
                class="w-full px-3 py-2 rounded-lg bg-surface-container-lowest border border-outline-variant/30 text-on-surface">
          <option value="">Todo</option>
          <option value="ofertas" <%= "selected" if @filters[:market] == "ofertas" %>>Ofertas</option>
          <option value="pedidos" <%= "selected" if @filters[:market] == "pedidos" %>>Pedidos</option>
        </select>
      </div>

      <div class="md:col-span-2">
        <label class="block text-label-md text-on-surface mb-1" for="filter-kind">Tipo</label>
        <select id="filter-kind" name="kind"
                data-action="change->auto-submit#submit"
                class="w-full px-3 py-2 rounded-lg bg-surface-container-lowest border border-outline-variant/30 text-on-surface">
          <option value="">Todos</option>
          <% Post::KINDS.each do |k| %>
            <option value="<%= k %>" <%= "selected" if @filters[:kind] == k %>><%= Post::KIND_LABELS_ES[k] || k.humanize %></option>
          <% end %>
        </select>
      </div>

      <div class="md:col-span-2">
        <label class="block text-label-md text-on-surface mb-1" for="filter-radius">Distancia</label>
        <select id="filter-radius" name="radius_km"
                data-action="change->auto-submit#submit"
                class="w-full px-3 py-2 rounded-lg bg-surface-container-lowest border border-outline-variant/30 text-on-surface">
          <% ExploreController::RADIUS_OPTIONS.each do |km| %>
            <option value="<%= km %>" <%= "selected" if @filters[:radius_km] == km %>><%= km %> km</option>
          <% end %>
          <option value="" <%= "selected" if @filters[:radius_km].nil? %>>Todos</option>
        </select>
      </div>

      <div class="md:col-span-1">
        <label class="block text-label-md text-on-surface mb-1" for="filter-credits">Máx. C</label>
        <input id="filter-credits" type="number" name="credits_max" value="<%= @filters[:credits_max] %>"
               min="1" step="1" placeholder="—"
               class="w-full px-3 py-2 rounded-lg bg-surface-container-lowest border border-outline-variant/30 text-on-surface placeholder:text-on-surface-variant">
      </div>
    </div>

    <div class="flex items-center justify-end gap-2 mt-3">
      <% if active_filters.positive? %>
        <%= link_to "Limpiar", explore_path,
              data: { turbo_frame: "explore-results", turbo_action: "advance" },
              class: "px-3 py-1.5 rounded-full text-label-md text-on-surface-variant hover:bg-surface-container" %>
      <% end %>
      <button type="submit"
              class="inline-flex items-center gap-1.5 px-4 py-2 rounded-full bg-primary text-on-primary text-label-md hover:bg-primary-strong cursor-pointer">
        <span class="material-symbols-outlined" style="font-size:16px">filter_alt</span>
        Filtrar
      </button>
    </div>
    <% end %>

    <% if authenticated? %>
      <%# Guardar la búsqueda actual como alerta (Fase 2.3). Lleva los filtros
          vigentes; el centro/radio se toma de tu ubicación al guardar. %>
      <div class="flex justify-end px-4 pb-4 -mt-1">
        <%= form_with url: saved_searches_path, method: :post, class: "inline" do %>
          <%= hidden_field_tag :q,           @filters[:q] %>
          <%= hidden_field_tag :category_id, @filters[:category_id] %>
          <%= hidden_field_tag :kind,        @filters[:kind] %>
          <%= hidden_field_tag :market,      @filters[:market] %>
          <%= hidden_field_tag :credits_max, @filters[:credits_max] %>
          <%= hidden_field_tag :radius_km,   @filters[:radius_km] %>
          <button type="submit"
                  class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full text-label-md text-primary border border-primary/40 hover:bg-primary-fixed/30 transition-colors cursor-pointer">
            <span class="material-symbols-outlined" style="font-size:16px">notifications_active</span>
            Guardar como alerta
          </button>
        <% end %>
      </div>
    <% end %>
  </details>

  <%= turbo_frame_tag "explore-results", target: "_top" do %>
    <% map_posts = @geo_posts.map { |p|
          { lat: p.latitude, lng: p.longitude,
            title: p.title, kind: p.kind, url: post_path(p) }
        } %>

    <div class="relative rounded-xl overflow-hidden border border-outline-variant/40 ambient-shadow bg-surface-container">
      <div data-controller="map"
           data-map-posts-value="<%= map_posts.to_json %>"
           <% if @coords %>data-map-center-value='<%= { lat: @coords[0], lng: @coords[1] }.to_json %>'<% end %>
           class="h-72 md:h-96 w-full"></div>

      <div class="absolute top-4 left-4 flex gap-2 pointer-events-none">
        <div class="bg-surface/90 glass-overlay px-3 py-1.5 rounded-full text-caption text-on-surface flex items-center gap-1 border border-outline-variant/30">
          <span class="material-symbols-outlined" style="font-size:14px">location_on</span>
          <%= @geo_posts.size %> publicaciones
        </div>
      </div>
    </div>

    <p class="text-caption text-on-surface-variant flex items-start gap-1.5 mt-3">
      <span class="material-symbols-outlined shrink-0 mt-px" style="font-size:16px">tips_and_updates</span>
      <span>Toca el botón <span class="font-mono">⌖</span> arriba a la derecha del mapa para centrar en tu ubicación.</span>
    </p>

    <div class="flex items-end justify-between pt-4">
      <h2 class="text-headline-md text-on-surface">Publicaciones</h2>
      <span class="text-caption text-on-surface-variant"><%= @posts.size %> resultado(s)</span>
    </div>

    <% if @posts.any? %>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-5 mt-4">
        <%= render @posts %>
      </div>
    <% else %>
      <div class="rounded-xl border border-dashed border-outline-variant/60 bg-surface-container-low/40 p-10 text-center mt-4 space-y-3">
        <span class="material-symbols-outlined text-on-surface-variant" style="font-size:36px">explore_off</span>
        <% if @no_results_for_query %>
          <p class="text-body-md text-on-surface">
            Nadie ofrece «<%= @filters[:q] %>» por acá todavía.
          </p>
          <p class="text-caption text-on-surface-variant max-w-md mx-auto">
            Publica lo que buscas: la comunidad lo verá y quien pueda ayudarte te contactará.
          </p>
          <%= link_to new_post_path(post: { title: @filters[:q] }),
                class: "inline-flex items-center gap-1.5 px-4 py-2 rounded-full bg-primary text-on-primary text-label-md hover:bg-primary-strong transition-colors" do %>
            <span class="material-symbols-outlined" style="font-size:18px">add</span>
            Publicar lo que busco
          <% end %>
        <% elsif !@sin_filtros %>
          <p class="text-body-md text-on-surface-variant">Ninguna publicación coincide con esos filtros.</p>
        <% else %>
          <p class="text-body-md text-on-surface-variant">Sin publicaciones cercanas aún.</p>
          <%= link_to new_post_path,
                class: "inline-flex items-center gap-1.5 px-4 py-2 rounded-full bg-primary text-on-primary text-label-md hover:bg-primary-strong transition-colors" do %>
            <span class="material-symbols-outlined" style="font-size:18px">add</span>
            Sé el primero en tu barrio
          <% end %>
        <% end %>
      </div>
    <% end %>

    <% if @more_posts.present? %>
      <div class="pt-6 space-y-3">
        <h2 class="text-headline-md text-on-surface">Más en Confianza</h2>
        <p class="text-caption text-on-surface-variant">Fuera de tu radio, lo más reciente de la red.</p>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
          <%= render @more_posts %>
        </div>
      </div>
    <% end %>
  <% end %>
</section>
