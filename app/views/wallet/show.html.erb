<% content_for :title, "Mi billetera" %>
<%# Refresh broadcast: nuevas LedgerEntry o cambio de nivel → morph del DOM. %>
<%= turbo_stream_from @user, :wallet %>
<%
  saldo   = @account.cached_balance.to_i
  fia     = @user.credit_floor.to_i
  level   = @user.level
  pasos   = pasos_para_subir(@progression)
%>

<article class="space-y-6">
  <header>
    <h1 class="text-headline-lg-mobile md:text-headline-lg text-on-surface">Mi billetera</h1>
    <p class="text-body-md text-on-surface-variant mt-1">Aquí ves tus créditos y lo que hiciste con ellos.</p>
  </header>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 lg:items-start">
    <%# Saldo: un número, en palabras %>
    <section class="lg:col-span-2 rounded-xl bg-surface-container-lowest border border-outline-variant/60 border-t-4 border-t-primary ambient-shadow p-5 sm:p-6 space-y-5">
      <div>
        <% if saldo.negative? %>
          <p class="text-body-lg text-on-surface">Debes</p>
          <p class="cifra text-[52px] leading-[56px] text-error"><%= creditos(saldo.abs) %></p>
          <p class="text-body-md text-on-surface-variant mt-1">Es normal. Lo devuelves cuando alguien te pague por algo.</p>
        <% else %>
          <p class="text-body-lg text-on-surface">Tienes</p>
          <p class="cifra text-[52px] leading-[56px] text-primary"><%= creditos(saldo) %></p>
          <p class="text-body-md text-on-surface-variant mt-1">Si te falta, la comunidad te fía hasta <%= creditos(fia) %>.</p>
        <% end %>
      </div>

      <div class="flex flex-col sm:flex-row gap-3">
        <%= link_to new_post_path,
              class: "inline-flex items-center justify-center gap-2 px-6 min-h-12 rounded-full bg-primary text-on-primary text-label-md hover:bg-primary-strong transition-colors" do %>
          <span class="material-symbols-outlined" style="font-size:20px">add_circle</span>
          Ofrece algo y gana créditos
        <% end %>
        <%= link_to interactions_path,
              class: "inline-flex items-center justify-center gap-2 px-6 min-h-12 rounded-full border-2 border-primary text-primary text-label-md hover:bg-primary-fixed/60 transition-colors" do %>
          <span class="material-symbols-outlined" style="font-size:20px">handshake</span>
          Mis intercambios
        <% end %>
      </div>

      <details class="group rounded-lg bg-surface-container-low border border-outline-variant/60">
        <summary class="flex items-center justify-between gap-2 px-4 min-h-12 cursor-pointer text-label-md text-on-surface list-none">
          <span class="flex items-center gap-2">
            <span class="material-symbols-outlined text-primary" style="font-size:20px">help</span>
            ¿Cómo funciona?
          </span>
          <span class="material-symbols-outlined transition-transform group-open:rotate-180" style="font-size:20px">expand_more</span>
        </summary>
        <ul class="px-4 pb-4 space-y-3 text-body-md text-on-surface-variant">
          <li class="flex gap-3">
            <span class="material-symbols-outlined text-primary shrink-0" style="font-size:20px">sync_alt</span>
            <span>Lo máximo por intercambio, en tu nivel: <strong class="text-on-surface"><%= creditos(@user.tx_cap) %></strong>.</span>
          </li>
          <li class="flex gap-3">
            <span class="material-symbols-outlined text-primary shrink-0" style="font-size:20px">groups</span>
            <span>Nadie puede juntar más de <strong class="text-on-surface"><%= creditos(@user.credit_ceiling) %></strong>. Es igual para todos.</span>
          </li>
          <li class="flex gap-3">
            <span class="material-symbols-outlined text-primary shrink-0" style="font-size:20px">location_on</span>
            <span>Cada intercambio deja un poquito para tu barrio.</span>
          </li>
          <li class="flex gap-3">
            <span class="material-symbols-outlined text-primary shrink-0" style="font-size:20px">balance</span>
            <span>Una parte pequeña se borra, para que los créditos no pierdan valor.</span>
          </li>
          <li>
            <%= link_to "Ver todas las reglas", economics_path, class: "inline-flex items-center gap-1 min-h-11 text-primary font-semibold hover:underline underline-offset-4" %>
          </li>
        </ul>
      </details>
    </section>

    <%# Nivel y reputación: estrellas y pasos en palabras %>
    <section class="rounded-xl bg-surface-container-lowest border border-outline-variant/60 border-t-4 border-t-secondary ambient-shadow p-5 sm:p-6 space-y-4">
      <header class="flex items-center justify-between gap-3">
        <div>
          <h2 class="text-headline-md text-on-surface">Nivel <%= level %></h2>
          <div class="flex items-center gap-2 mt-1">
            <%= estrellas(@user.trust_score) %>
            <span class="text-caption text-on-surface-variant">tu reputación</span>
          </div>
        </div>
      </header>

      <% if @next_level_limits %>
        <div>
          <p class="text-label-md text-on-surface">Para subir al Nivel <%= level + 1 %>:</p>
          <ul class="mt-2 space-y-1">
            <% pasos.each do |paso| %>
              <li class="flex items-start gap-2 text-body-md <%= paso[:hecho] ? "text-on-surface-variant" : "text-on-surface" %>">
                <span class="material-symbols-outlined shrink-0 mt-0.5 <%= paso[:hecho] ? "icon-filled text-tertiary" : "text-on-surface-variant" %>" style="font-size:20px"><%= paso[:hecho] ? "check_circle" : "radio_button_unchecked" %></span>
                <span><%= paso[:texto] %></span>
              </li>
            <% end %>
          </ul>
          <p class="text-caption text-on-surface-variant mt-3">Al subir, la comunidad te fía más.</p>
        </div>
      <% else %>
        <p class="text-body-md text-on-surface-variant">Llegaste al nivel más alto. Gracias por sostener la red.</p>
      <% end %>

      <%= link_to achievements_path,
            class: "flex items-center justify-between gap-2 min-h-11 pt-3 border-t border-outline-variant/60 text-label-md text-primary hover:text-primary-strong transition-colors" do %>
        <span class="flex items-center gap-2">
          <span class="material-symbols-outlined icon-filled" style="font-size:18px">emoji_events</span>
          Ver mis logros
        </span>
        <span class="material-symbols-outlined" style="font-size:18px">chevron_right</span>
      <% end %>
    </section>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
    <%# Movimientos en frases %>
    <section class="lg:col-span-2 rounded-xl bg-surface-container-lowest border border-outline-variant/60 ambient-shadow p-5 sm:p-6">
      <h2 class="text-headline-md text-on-surface mb-4">Tus movimientos</h2>

      <% if @ledger_entries.any? %>
        <ul class="flex flex-col gap-2">
          <% @ledger_entries.each do |entry| %>
            <%
              tx          = entry.credit_transaction
              interaction = tx&.interaction
              other       = interaction&.other_party(@user)
              pagaste     = entry.direction == "debit"
            %>
            <li>
              <%= link_to (interaction ? interaction_path(interaction) : "#"),
                    class: "flex items-center gap-3 p-3 rounded-lg hover:bg-surface-container-low transition-colors" do %>
                <span class="w-10 h-10 rounded-full grid place-items-center shrink-0 <%= pagaste ? "bg-error-container text-error" : "bg-primary-fixed text-primary" %>" aria-hidden="true">
                  <span class="material-symbols-outlined" style="font-size:20px"><%= pagaste ? "arrow_upward" : "arrow_downward" %></span>
                </span>
                <div class="min-w-0 flex-1">
                  <p class="text-body-md text-on-surface">
                    <% if interaction %>
                      <%= pagaste ? "Pagaste" : "Te pagaron" %>
                      <strong class="<%= pagaste ? "text-error" : "text-primary" %>"><%= creditos(entry.amount) %></strong>
                      por «<%= interaction.post.title %>»
                    <% else %>
                      <%= pagaste ? "Salieron" : "Entraron" %> <strong><%= creditos(entry.amount) %></strong>
                    <% end %>
                  </p>
                  <p class="text-caption text-on-surface-variant">
                    <% if other %>
                      <%= pagaste ? "A" : "De" %> @<%= other.username || other.email_address %> ·
                    <% end %>
                    <%= l(entry.created_at.to_date, format: :long) rescue entry.created_at.to_date %>
                    <% if pagaste && tx && tx.community_amount.to_i.positive? %>
                      · <%= creditos(tx.community_amount) %> para tu barrio
                    <% end %>
                  </p>
                </div>
              <% end %>
            </li>
          <% end %>
        </ul>
      <% else %>
        <div class="text-center py-8">
          <span class="material-symbols-outlined text-on-surface-variant mb-2" style="font-size:36px">inbox</span>
          <p class="text-body-md text-on-surface-variant">Todavía no tienes movimientos.</p>
          <p class="text-caption text-on-surface-variant mt-1">Aparecen cuando cierras tu primer intercambio.</p>
        </div>
      <% end %>
    </section>

    <%# Tu barrio %>
    <aside>
      <% if @territory %>
        <% community = @territory.community_account %>
        <%= link_to territory_path(@territory.slug),
              class: "block rounded-xl bg-surface-container-lowest border border-outline-variant/60 border-t-[6px] border-t-signal ambient-shadow p-5 hover:border-outline transition-colors" do %>
          <p class="text-label-md text-on-surface flex items-center gap-2">
            <span class="material-symbols-outlined icon-filled text-primary" style="font-size:20px">volunteer_activism</span>
            Fondo de <%= @territory.name %>
          </p>
          <p class="cifra text-[32px] leading-10 text-primary mt-2"><%= creditos(community&.cached_balance) %></p>
          <p class="text-body-md text-on-surface-variant mt-1">Es de todo el barrio. Los vecinos votan en qué usarlo.</p>
          <span class="inline-flex items-center gap-1 min-h-11 text-label-md text-primary">
            Ver tu barrio
            <span class="material-symbols-outlined" style="font-size:18px">arrow_forward</span>
          </span>
        <% end %>
      <% else %>
        <div class="rounded-xl bg-surface-container-low border border-outline-variant/60 p-5">
          <p class="text-label-md text-on-surface flex items-center gap-2">
            <span class="material-symbols-outlined text-on-surface-variant" style="font-size:20px">location_off</span>
            Fondo de tu barrio
          </p>
          <p class="text-body-md text-on-surface-variant mt-2">Comparte tu ubicación en el inicio para verlo.</p>
        </div>
      <% end %>
    </aside>
  </div>
</article>
