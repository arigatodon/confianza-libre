<% content_for :title, "Recuperar contraseña" %>

<section class="max-w-md mx-auto space-y-6 pt-6">
  <header class="space-y-2 text-center">
    <span class="inline-flex w-14 h-14 rounded-2xl bg-tertiary-container text-on-tertiary-container items-center justify-center mx-auto">
      <span class="material-symbols-outlined icon-filled" style="font-size:28px">lock_reset</span>
    </span>
    <h1 class="text-headline-lg-mobile md:text-headline-lg text-on-surface">¿Olvidaste tu contraseña?</h1>
    <p class="text-body-md text-on-surface-variant">Te enviamos un enlace para restablecerla.</p>
  </header>

  <div class="rounded-xl bg-surface-container-lowest border border-outline-variant/30 ambient-shadow p-6">
    <% if alert = flash[:alert] %>
      <div class="rounded-lg bg-error-container border border-error/30 text-on-error-container px-3 py-2 text-sm mb-4" id="alert"><%= alert %></div>
    <% end %>

    <%= form_with url: passwords_path, class: "space-y-4" do |form| %>
      <div>
        <%= form.label :email_address, "Email", class: "block text-label-md text-on-surface mb-1.5" %>
        <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username",
              placeholder: "tunombre@email.com", value: params[:email_address] %>
      </div>

      <div class="flex items-center justify-between gap-3 flex-wrap pt-2">
        <%= form.submit "Enviar instrucciones",
              class: "inline-flex items-center justify-center gap-2 px-5 py-2.5 rounded-full bg-primary text-on-primary text-label-md hover:bg-organic-green-deep cursor-pointer" %>
        <%= link_to "Volver", new_session_path,
              class: "text-caption text-on-surface-variant hover:text-on-surface" %>
      </div>
    <% end %>
  </div>
</section>
