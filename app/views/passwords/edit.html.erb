<% content_for :title, "Nueva contraseña" %>

<section class="max-w-md mx-auto space-y-6 pt-6">
  <header class="space-y-2 text-center">
    <span class="inline-flex w-14 h-14 rounded-2xl bg-primary text-on-primary items-center justify-center mx-auto">
      <span class="material-symbols-outlined icon-filled" style="font-size:28px">password</span>
    </span>
    <h1 class="text-headline-lg-mobile md:text-headline-lg text-on-surface">Cambia tu contraseña</h1>
  </header>

  <div class="rounded-xl bg-surface-container-lowest border border-outline-variant/30 ambient-shadow p-6">
    <% if alert = flash[:alert] %>
      <div class="rounded-lg bg-error-container border border-error/30 text-on-error-container px-3 py-2 text-sm mb-4" id="alert"><%= alert %></div>
    <% end %>

    <%= form_with url: password_path(params[:token]), method: :put, class: "space-y-4" do |form| %>
      <div>
        <%= form.label :password, "Nueva contraseña", class: "block text-label-md text-on-surface mb-1.5" %>
        <%= form.password_field :password, required: true, autocomplete: "new-password", maxlength: 72 %>
      </div>

      <div>
        <%= form.label :password_confirmation, "Repite la nueva contraseña", class: "block text-label-md text-on-surface mb-1.5" %>
        <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password", maxlength: 72 %>
      </div>

      <div class="pt-2">
        <%= form.submit "Guardar",
              class: "inline-flex items-center justify-center gap-2 px-5 py-2.5 rounded-full bg-primary text-on-primary text-label-md hover:bg-primary-strong cursor-pointer" %>
      </div>
    <% end %>
  </div>
</section>
