<%# Render neutral, igual que messages/_message: chat_controller alinea los propios. %>
<div id="<%= dom_id(direct_message) %>"
     class="flex justify-start"
     data-msg-user-id="<%= direct_message.user_id %>">
  <div class="bubble max-w-xs md:max-w-md rounded-2xl px-3 py-2 bg-surface-container text-on-surface">
    <p class="username text-caption font-semibold text-primary mb-0.5">
      @<%= direct_message.user.username || direct_message.user.email_address %>
    </p>
    <p class="text-body-md whitespace-pre-wrap"><%= direct_message.body %></p>
    <p class="text-[10px] mt-0.5 opacity-70 flex items-center gap-2">
      <%= l(direct_message.created_at, format: :short) rescue direct_message.created_at.strftime("%H:%M") %>
      <%= report_link(direct_message, label: "", classes: "opacity-60 hover:opacity-100 hover:text-error") %>
    </p>
  </div>
</div>
