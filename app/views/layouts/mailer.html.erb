<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8">
    <title>Confianza</title>
  </head>
  <body style="margin:0; padding:0; background-color:#f5f4f0; -webkit-font-smoothing:antialiased;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background-color:#f5f4f0;">
      <tr>
        <td align="center" style="padding:24px 12px;">
          <table role="presentation" width="600" cellpadding="0" cellspacing="0" style="max-width:600px; width:100%; font-family:'Helvetica Neue',Helvetica,Arial,sans-serif;">
            <!-- Encabezado de marca -->
            <tr>
              <td style="background-color:#1f56a8; border-radius:12px 12px 0 0; border-bottom:4px solid #ffc629; padding:28px 32px; text-align:center;">
                <span style="display:inline-block; font-size:22px; font-weight:800; letter-spacing:0.2px; color:#ffffff;">
                  <span style="color:#ffc629;">&#9679;</span>&nbsp; Confianza
                </span>
                <div style="margin-top:6px; font-size:11px; color:#d6e3f7; letter-spacing:1.5px; text-transform:uppercase;">
                  Capital comunitario
                </div>
              </td>
            </tr>
            <!-- Cuerpo -->
            <tr>
              <td style="background-color:#ffffff; padding:32px; color:#15181c; font-size:16px; line-height:1.6;">
                <%= yield %>
              </td>
            </tr>
            <!-- Pie institucional -->
            <tr>
              <td style="background-color:#ffffff; border-radius:0 0 12px 12px; padding:20px 32px 28px; border-top:1px solid #e2e1da;">
                <p style="margin:0 0 8px; font-size:13px; color:#5b616a; line-height:1.5;">
                  Te escribe <strong>Confianza</strong>, la red de reputación y créditos comunitarios.
                </p>
                <p style="margin:0; font-size:13px; color:#5b616a;">
                  <a href="https://confianza.world" style="color:#1f56a8; text-decoration:none;">confianza.world</a>
                  &nbsp;·&nbsp; No respondas a este correo (casilla no monitoreada).
                </p>
              </td>
            </tr>
            <tr>
              <td style="padding:16px 32px; text-align:center;">
                <p style="margin:0; font-size:11px; color:#80868e;">
                  © Confianza · no-reply@confianza.world
                </p>
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
