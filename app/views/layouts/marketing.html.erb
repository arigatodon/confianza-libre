<!DOCTYPE html>
<html lang="es">
  <head>
    <title><%= content_for(:title) || "Confianza — La red de confianza que fortalece tu comunidad" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Confianza">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="theme-color" content="#0f5238">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <% if content_for?(:head) %>
      <%= yield :head %>
    <% else %>
      <%= seo_meta_tags(title: content_for(:title).presence, description: ApplicationHelper::SITE_DESCRIPTION, canonical: request.original_url) %>
    <% end %>
    <%= render "shared/site_json_ld" %>

    <link rel="icon" href="/favicon.ico" sizes="any">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200&display=swap" rel="stylesheet">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="bg-background text-on-background font-body antialiased selection:bg-primary/20">
    <%# Top App Bar marketing %>
    <header class="bg-surface/90 backdrop-blur-md sticky top-0 z-50 border-b border-outline-variant/30 transition-all duration-200">
      <div class="flex justify-between items-center w-full px-margin-mobile md:px-margin-desktop max-w-(--container-3xl) mx-auto h-20">
        <%= link_to root_path, class: "flex items-center gap-2" do %>
          <span class="w-9 h-9 rounded-lg bg-primary text-on-primary grid place-items-center">
            <span class="material-symbols-outlined icon-filled" style="font-size:20px">handshake</span>
          </span>
          <span class="text-headline-md text-primary font-bold tracking-tight">Confianza</span>
        <% end %>

        <nav class="hidden md:flex gap-8">
          <%= link_to "Cómo funciona", how_it_works_path,
                class: "text-on-surface-variant font-medium hover:text-primary transition-colors text-label-md" %>
          <%= link_to "Manifiesto", manifesto_path,
                class: "text-on-surface-variant font-medium hover:text-primary transition-colors text-label-md" %>
          <%= link_to "Novedades", announcements_path,
                class: "text-on-surface-variant font-medium hover:text-primary transition-colors text-label-md" %>
          <%= link_to "Explorar", explore_path,
                class: "text-on-surface-variant font-medium hover:text-primary transition-colors text-label-md" %>
        </nav>

        <div class="flex items-center gap-2">
          <% if authenticated? %>
            <%= link_to "Ir al feed", root_path,
                  class: "bg-primary hover:bg-organic-green-deep text-on-primary px-5 md:px-6 py-2 rounded-full text-label-md transition-colors shadow-sm" %>
          <% else %>
            <%= link_to "Crear cuenta", signup_path,
                  class: "hidden sm:inline-block text-primary hover:text-organic-green-deep px-3 py-2 rounded-full text-label-md transition-colors" %>
            <%= link_to "Ingresar", new_session_path,
                  class: "bg-primary hover:bg-organic-green-deep text-on-primary px-5 md:px-6 py-2 rounded-full text-label-md transition-colors shadow-sm" %>
          <% end %>
        </div>
      </div>
    </header>

    <main>
      <%= yield %>
    </main>

    <%# Footer %>
    <footer class="bg-surface-container-low mt-20 border-t border-outline-variant/30">
      <div class="max-w-(--container-3xl) mx-auto px-margin-mobile md:px-margin-desktop py-10 flex flex-col md:flex-row justify-between items-center gap-4">
        <%= link_to root_path, class: "flex items-center gap-2" do %>
          <span class="w-8 h-8 rounded-lg bg-primary text-on-primary grid place-items-center">
            <span class="material-symbols-outlined icon-filled" style="font-size:18px">handshake</span>
          </span>
          <span class="text-headline-md text-primary font-bold">Confianza</span>
        <% end %>
        <p class="text-body-md text-on-surface-variant text-sm text-center md:text-left">
          © <%= Date.current.year %> Confianza. Capital Comunitario para el Territorio.
        </p>
        <div class="flex flex-wrap justify-center gap-6">
          <%= link_to "Cómo funciona", how_it_works_path,
                class: "text-label-md text-on-surface-variant hover:text-primary transition-colors" %>
          <%= link_to "Manifiesto", manifesto_path,
                class: "text-label-md text-on-surface-variant hover:text-primary transition-colors" %>
          <%= link_to "Novedades", announcements_path,
                class: "text-label-md text-on-surface-variant hover:text-primary transition-colors" %>
          <%= link_to "Economía", economics_path,
                class: "text-label-md text-on-surface-variant hover:text-primary transition-colors" %>
          <%= link_to "Ingresar", new_session_path,
                class: "text-label-md text-on-surface-variant hover:text-primary transition-colors" %>
          <%= link_to "Feedback", new_feedback_path,
                class: "text-label-md text-on-surface-variant hover:text-primary transition-colors" %>
          <%= link_to "API", api_docs_path,
                class: "text-on-surface-variant hover:text-primary transition-colors text-label-md" %>
          <%= link_to "Privacidad", privacy_path,
                class: "text-label-md text-on-surface-variant hover:text-primary transition-colors" %>
        </div>
      </div>
    </footer>
    <%= render "shared/beta_feedback_button" %>
  </body>
</html>
