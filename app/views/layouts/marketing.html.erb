<!DOCTYPE html>
<html lang="es">
  <head>
    <title><%= content_for(:title) || "Confianza — La red de confianza que fortalece tu comunidad" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Confianza">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="theme-color" content="#1f56a8">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <% if content_for?(:head) %>
      <%= yield :head %>
    <% else %>
      <%= seo_meta_tags(title: content_for(:title).presence, description: ApplicationHelper::SITE_DESCRIPTION, canonical: request.original_url) %>
    <% end %>
    <%= render "shared/site_json_ld" %>

    <link rel="icon" href="/favicon.ico" sizes="any">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png">

    <%= render "shared/fuentes" %>

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="bg-background text-on-background font-body antialiased overflow-x-hidden">
    <%# Cabecera marketing: placa blanca con la franja azul de señalética arriba %>
    <header class="bg-surface-container-lowest/95 backdrop-blur-md sticky top-0 z-50 border-b border-outline-variant/60 border-t-4 border-t-primary">
      <div class="flex justify-between items-center gap-3 w-full px-margin-mobile md:px-margin-desktop max-w-(--container-3xl) mx-auto h-16 md:h-[72px]">
        <%= render "shared/logo", tamano: :md %>

        <nav class="hidden md:flex gap-1">
          <%= link_to "Cómo funciona", how_it_works_path,
                class: "text-on-surface-variant hover:text-primary hover:bg-surface-container-low transition-colors text-label-md px-3 min-h-11 inline-flex items-center rounded-md" %>
          <%= link_to "Manifiesto", manifesto_path,
                class: "text-on-surface-variant hover:text-primary hover:bg-surface-container-low transition-colors text-label-md px-3 min-h-11 inline-flex items-center rounded-md" %>
          <%= link_to "Novedades", announcements_path,
                class: "text-on-surface-variant hover:text-primary hover:bg-surface-container-low transition-colors text-label-md px-3 min-h-11 inline-flex items-center rounded-md" %>
          <%= link_to "Explorar", explore_path,
                class: "text-on-surface-variant hover:text-primary hover:bg-surface-container-low transition-colors text-label-md px-3 min-h-11 inline-flex items-center rounded-md" %>
        </nav>

        <div class="flex items-center gap-1 sm:gap-2">
          <% if authenticated? %>
            <%= link_to "Ir al feed", root_path,
                  class: "bg-primary hover:bg-primary-strong text-on-primary px-5 md:px-6 min-h-11 inline-flex items-center rounded-full text-label-md transition-colors" %>
          <% else %>
            <%= link_to "Crear cuenta", signup_path,
                  class: "hidden sm:inline-flex items-center min-h-11 text-primary hover:bg-primary-fixed/60 px-4 rounded-full text-label-md transition-colors" %>
            <%= link_to "Ingresar", new_session_path,
                  class: "bg-primary hover:bg-primary-strong text-on-primary px-5 md:px-6 min-h-11 inline-flex items-center rounded-full text-label-md transition-colors" %>
          <% end %>
        </div>
      </div>
    </header>

    <main>
      <%= yield %>
    </main>

    <%# Pie: franja azul profunda, cierra la página como un letrero %>
    <footer class="bg-primary-container text-on-primary-container mt-12 foco-claro">
      <div class="h-1.5 flex" aria-hidden="true">
        <span class="flex-[6] bg-primary"></span><span class="flex-1 bg-signal"></span>
      </div>
      <div class="max-w-(--container-3xl) mx-auto px-margin-mobile md:px-margin-desktop py-10 flex flex-col md:flex-row justify-between items-center md:items-start gap-6">
        <div class="flex flex-col items-center md:items-start gap-3">
          <%= render "shared/logo", tono: :blanco, tamano: :md %>
          <p class="text-body-md text-on-primary-container text-sm text-center md:text-left">
            © <%= Date.current.year %> Confianza. Capital Comunitario para el Territorio.
          </p>
        </div>
        <div class="flex flex-wrap justify-center md:justify-end gap-x-2 gap-y-0 max-w-xl">
          <%= link_to "Cómo funciona", how_it_works_path,
                class: "text-label-md text-on-primary hover:underline underline-offset-4 px-3 min-h-11 inline-flex items-center" %>
          <%= link_to "Manifiesto", manifesto_path,
                class: "text-label-md text-on-primary hover:underline underline-offset-4 px-3 min-h-11 inline-flex items-center" %>
          <%= link_to "Novedades", announcements_path,
                class: "text-label-md text-on-primary hover:underline underline-offset-4 px-3 min-h-11 inline-flex items-center" %>
          <%= link_to "Economía", economics_path,
                class: "text-label-md text-on-primary hover:underline underline-offset-4 px-3 min-h-11 inline-flex items-center" %>
          <%= link_to "Ingresar", new_session_path,
                class: "text-label-md text-on-primary hover:underline underline-offset-4 px-3 min-h-11 inline-flex items-center" %>
          <%= link_to "Tu opinión", new_feedback_path,
                class: "text-label-md text-on-primary hover:underline underline-offset-4 px-3 min-h-11 inline-flex items-center" %>
          <%= link_to "API", api_docs_path,
                class: "text-label-md text-on-primary hover:underline underline-offset-4 px-3 min-h-11 inline-flex items-center" %>
          <%= link_to "Privacidad", privacy_path,
                class: "text-label-md text-on-primary hover:underline underline-offset-4 px-3 min-h-11 inline-flex items-center" %>
        </div>
      </div>
    </footer>
    <%= render "shared/beta_feedback_button" %>
  </body>
</html>
