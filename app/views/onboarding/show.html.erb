<% content_for :title, "Bienvenida a Confianza" %>

<%
  fia = Current.session.user.credit_floor.to_i
  # Cinco ideas, una frase cada una. Las reglas exactas están en /economia.
  steps = [
    { icon: "diversity_3", title: "Bienvenida a Confianza",
      body: "Una red de vecinos para intercambiar cosas y ayuda. Sin usar dinero." },
    { icon: "savings", title: "Pagas con créditos",
      body: "Cuando alguien te ayuda, le pagas con créditos (C). Todos empiezan con 0 C." },
    { icon: "handshake", title: "La comunidad te fía",
      body: "Si te faltan créditos, puedes quedar debiendo hasta #{creditos(fia)}. Lo devuelves ayudando a otros." },
    { icon: "volunteer_activism", title: "Tu barrio gana",
      body: "Cada intercambio deja un poquito para el fondo del barrio. Los vecinos votan en qué usarlo." },
    { icon: "star", title: "Las estrellas cuentan",
      body: "Después de cada intercambio, los dos se dejan estrellas. Con buenas reseñas, subes de nivel." }
  ]
  current  = (@step || 1).to_i.clamp(1, steps.size)
  step     = steps[current - 1]
  total    = steps.size
  is_last  = current == total
%>

<article class="max-w-2xl mx-auto">
  <div class="rounded-2xl bg-surface-container-lowest border border-outline-variant/60 p-5 sm:p-8 ambient-shadow space-y-6">
    <%# Header con progreso %>
    <header class="space-y-3">
      <div class="flex items-center justify-between">
        <span class="text-caption text-on-surface-variant uppercase tracking-wider">
          Paso <%= current %> de <%= total %>
        </span>
        <%= button_to "Saltar", skip_onboarding_path,
              method: :post,
              class: "text-label-md text-on-surface-variant hover:text-on-surface min-h-11 px-2 cursor-pointer" %>
      </div>
      <div class="grid gap-1" style="grid-template-columns: repeat(<%= total %>, minmax(0, 1fr))">
        <% (1..total).each do |n| %>
          <span class="h-1.5 rounded-full <%= n <= current ? "bg-primary" : "bg-surface-container-high" %>"></span>
        <% end %>
      </div>
    </header>

    <%# Contenido del paso %>
    <div class="text-center space-y-4 py-4">
      <div class="w-20 h-20 mx-auto rounded-2xl bg-primary-fixed grid place-items-center">
        <span class="material-symbols-outlined icon-filled text-primary" style="font-size:42px"><%= step[:icon] %></span>
      </div>
      <h1 class="text-headline-md md:text-headline-lg text-on-surface"><%= step[:title] %></h1>
      <p class="text-body-lg text-on-surface-variant max-w-prose mx-auto"><%= step[:body] %></p>
      <% if is_last %>
        <%= link_to "Ver todas las reglas", economics_path, class: "inline-flex items-center min-h-11 text-label-md text-primary hover:underline underline-offset-4" %>
      <% end %>
    </div>

    <%# Footer de navegación %>
    <footer class="flex items-center justify-between pt-4 border-t border-outline-variant/30">
      <% if current > 1 %>
        <%= link_to onboarding_path(step: current - 1),
              class: "inline-flex items-center gap-1.5 px-4 min-h-11 rounded-full text-on-surface-variant hover:bg-surface-container text-label-md" do %>
          <span class="material-symbols-outlined" style="font-size:18px">arrow_back</span>
          Anterior
        <% end %>
      <% else %>
        <span></span>
      <% end %>

      <% if is_last %>
        <%= button_to complete_onboarding_path, method: :post,
              class: "inline-flex items-center gap-1.5 px-6 min-h-12 rounded-full bg-primary text-on-primary text-label-md hover:bg-primary-strong cursor-pointer" do %>
          <span class="material-symbols-outlined" style="font-size:18px">check</span>
          Empezar
        <% end %>
      <% else %>
        <%= link_to onboarding_path(step: current + 1),
              class: "inline-flex items-center gap-1.5 px-6 min-h-12 rounded-full bg-primary text-on-primary text-label-md hover:bg-primary-strong" do %>
          Siguiente
          <span class="material-symbols-outlined" style="font-size:18px">arrow_forward</span>
        <% end %>
      <% end %>
    </footer>
  </div>

  <p class="text-caption text-on-surface-variant text-center mt-6">
    Puedes volver a verlo desde <%= link_to "Ajustes", settings_path, class: "text-primary hover:underline" %>.
  </p>
</article>
