<% content_for :title, "Confianza — La red de confianza que fortalece tu comunidad" %>

<%# Hero %>
<section class="pt-10 pb-14 md:py-20 px-margin-mobile md:px-margin-desktop max-w-[1280px] mx-auto">
  <div class="grid md:grid-cols-2 gap-10 md:gap-12 items-center">
    <div class="space-y-6">
      <div class="inline-flex items-center gap-1.5 pl-2 pr-3 py-1.5 bg-primary text-on-primary rounded-md">
        <span class="material-symbols-outlined icon-filled" style="font-size:18px">location_on</span>
        <span class="text-rotulo">Red de vecinos</span>
      </div>
      <h1 class="font-display font-extrabold text-[34px] leading-[38px] md:text-headline-xl tracking-[-0.02em] text-ink">
        La red de confianza que fortalece tu comunidad
      </h1>
      <p class="text-body-lg text-on-surface-variant max-w-xl">
        Ofrece lo que sabes hacer, pide lo que necesitas y paga con créditos, no con dinero.
      </p>
      <div class="flex flex-col sm:flex-row gap-3 pt-2">
        <%= link_to signup_path,
              class: "bg-primary hover:bg-primary-strong text-on-primary px-7 min-h-12 rounded-full text-label-md transition-colors flex justify-center items-center gap-2" do %>
          Unirse a la red
          <span class="material-symbols-outlined" style="font-size:20px">arrow_forward</span>
        <% end %>
        <%= link_to "Cómo funciona", how_it_works_path,
              class: "border-2 border-primary text-primary px-7 min-h-12 rounded-full text-label-md hover:bg-primary-fixed/60 transition-colors flex justify-center items-center" %>
      </div>
    </div>

    <%# Ilustración: plano de barrio con señales de lo que se ofrece. Sin fotos
        ni personas: la tarjeta de abajo es un ejemplo y lo dice. %>
    <%
      senales = [
        [ "bakery_dining",      "bg-secondary",         "left:16%;top:24%" ],
        [ "handyman",           "bg-primary",           "left:58%;top:24%" ],
        [ "school",             "bg-tertiary",          "left:84%;top:36%" ],
        [ "local_shipping",     "bg-primary-container", "left:28%;top:52%" ],
        [ "volunteer_activism", "bg-tertiary",          "left:70%;top:58%" ]
      ]
    %>
    <div class="relative h-[340px] md:h-[480px] rounded-xl overflow-hidden border border-outline-variant/70 ambient-shadow-lg">
      <%= render "home/plano_barrio" %>
      <% senales.each do |icono, fondo, posicion| %>
        <span class="absolute -translate-x-1/2 -translate-y-full flex flex-col items-center" style="<%= posicion %>" aria-hidden="true">
          <span class="w-11 h-11 rounded-lg <%= fondo %> text-on-primary grid place-items-center ambient-shadow-lg">
            <span class="material-symbols-outlined icon-filled" style="font-size:24px"><%= icono %></span>
          </span>
          <span class="w-3 h-3 -mt-2 rotate-45 <%= fondo %>"></span>
        </span>
      <% end %>
      <%# "Aquí": el punto de la marca %>
      <span class="absolute left-[47%] top-[40%] w-8 h-8 -translate-x-1/2 -translate-y-1/2 rounded-full bg-signal border-[6px] border-primary ambient-shadow-lg" aria-hidden="true"></span>

      <div class="absolute bottom-4 left-4 right-4 md:bottom-6 md:left-6 md:right-6 bg-surface-container-lowest p-4 rounded-lg border border-outline-variant/70 ambient-shadow-lg flex items-center gap-4">
        <div class="w-12 h-12 rounded-lg bg-signal text-ink flex items-center justify-center shrink-0">
          <span class="material-symbols-outlined icon-filled">handshake</span>
        </div>
        <div class="min-w-0">
          <p class="flex items-center gap-2">
            <span class="text-label-md text-on-surface">Intercambio exitoso</span>
            <span class="text-rotulo px-1.5 py-0.5 rounded-sm bg-surface-container-high text-on-surface-variant" style="font-size:10px">Ejemplo</span>
          </p>
          <p class="text-caption text-on-surface-variant">Así se ve un trato cerrado entre vecinos.</p>
        </div>
      </div>
    </div>
  </div>
</section>

<%# Cómo funciona — resumen 3 pasos %>
<section class="py-16 md:py-20 bg-surface-container-low border-y border-outline-variant/60 px-margin-mobile md:px-margin-desktop" id="como-funciona">
  <div class="max-w-[1280px] mx-auto">
    <div class="text-center mb-10 md:mb-14">
      <h2 class="text-headline-lg-mobile md:text-headline-lg text-ink mb-4">
        Cómo funciona Confianza
      </h2>
      <p class="text-body-md text-on-surface-variant max-w-2xl mx-auto">
        Tres pasos, sin dinero de por medio.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      <%# Paso 1 %>
      <div class="bg-surface-container-lowest rounded-xl p-6 md:p-8 ambient-shadow border border-outline-variant/60 border-t-4 border-t-secondary flex flex-col items-start">
        <div class="w-12 h-12 rounded-lg bg-secondary text-on-secondary flex items-center justify-center mb-5">
          <span class="material-symbols-outlined" style="font-size:28px">add_circle</span>
        </div>
        <p class="text-rotulo text-on-surface-variant">Paso 1</p>
        <h3 class="text-headline-md text-on-surface mb-2">Publica</h3>
        <p class="text-body-md text-on-surface-variant flex-grow">
          Cuenta qué ofreces o qué necesitas.
        </p>
      </div>

      <%# Paso 2 %>
      <div class="bg-surface-container-lowest rounded-xl p-6 md:p-8 ambient-shadow border border-outline-variant/60 border-t-4 border-t-primary flex flex-col items-start">
        <div class="w-12 h-12 rounded-lg bg-primary text-on-primary flex items-center justify-center mb-5">
          <span class="material-symbols-outlined" style="font-size:28px">sync_alt</span>
        </div>
        <p class="text-rotulo text-on-surface-variant">Paso 2</p>
        <h3 class="text-headline-md text-on-surface mb-2">Intercambia</h3>
        <p class="text-body-md text-on-surface-variant flex-grow">
          Ponte de acuerdo con un vecino y paguen con créditos.
        </p>
      </div>

      <%# Paso 3 %>
      <div class="bg-surface-container-lowest rounded-xl p-6 md:p-8 ambient-shadow border border-outline-variant/60 border-t-4 border-t-tertiary flex flex-col items-start">
        <div class="w-12 h-12 rounded-lg bg-tertiary text-on-tertiary flex items-center justify-center mb-5">
          <span class="material-symbols-outlined" style="font-size:28px">star</span>
        </div>
        <p class="text-rotulo text-on-surface-variant">Paso 3</p>
        <h3 class="text-headline-md text-on-surface mb-2">Evalúa</h3>
        <p class="text-body-md text-on-surface-variant flex-grow">
          Deja estrellas. Así todos saben en quién confiar.
        </p>
      </div>
    </div>

    <div class="text-center mt-12">
      <%= link_to how_it_works_path,
            class: "inline-flex items-center gap-2 min-h-11 px-2 text-primary text-label-md hover:underline underline-offset-4" do %>
        Ver cómo funciona
        <span class="material-symbols-outlined" style="font-size:18px">arrow_forward</span>
      <% end %>
    </div>
  </div>
</section>

<%# Reputación %>
<section class="py-16 md:py-20 px-margin-mobile md:px-margin-desktop max-w-[1280px] mx-auto" id="reputacion">
  <div class="grid md:grid-cols-2 gap-10 md:gap-16 items-center">
    <div class="order-2 md:order-1">
      <%# Tarjeta de ejemplo (no es una persona real): muestra cómo se ve un perfil. %>
      <div class="bg-surface-container-lowest rounded-xl p-6 ambient-shadow-lg border border-outline-variant/60 border-t-4 border-t-primary max-w-sm mx-auto">
        <div class="flex items-start gap-4 mb-6">
          <div class="relative shrink-0">
            <div class="w-16 h-16 rounded-full bg-primary-fixed text-on-primary-fixed grid place-items-center" aria-hidden="true">
              <span class="material-symbols-outlined icon-filled" style="font-size:36px">person</span>
            </div>
            <div class="absolute -bottom-1 -right-1 w-6 h-6 rounded-full bg-primary flex items-center justify-center border-2 border-surface-container-lowest">
              <span class="material-symbols-outlined icon-filled text-on-primary" style="font-size:14px">check</span>
            </div>
          </div>
          <div class="flex-1 min-w-0">
            <h4 class="text-headline-md text-on-surface text-lg">Tu nombre</h4>
            <p class="text-caption text-on-surface-variant">Vecina Verificada</p>
          </div>
          <span class="text-rotulo px-2 py-1 rounded-sm bg-signal text-ink shrink-0" style="font-size:10px">Ejemplo</span>
        </div>
        <div class="space-y-4">
          <div>
            <div class="flex justify-between text-sm mb-1.5">
              <span class="text-label-md text-on-surface">Nivel de Confianza</span>
              <span class="text-label-md text-primary">Nivel 4</span>
            </div>
            <div class="flex gap-1 h-2.5" aria-hidden="true">
              <div class="flex-1 bg-primary rounded-l-sm"></div>
              <div class="flex-1 bg-primary"></div>
              <div class="flex-1 bg-primary"></div>
              <div class="flex-1 bg-primary"></div>
              <div class="flex-1 bg-surface-container-high rounded-r-sm"></div>
            </div>
          </div>
          <div class="pt-4 border-t border-outline-variant/60 flex items-center justify-between gap-3">
            <p class="text-body-md text-on-surface"><strong class="cifra">42</strong> intercambios</p>
            <%= estrellas(5) %>
          </div>
        </div>
      </div>
    </div>

    <div class="order-1 md:order-2 space-y-6">
      <div class="inline-flex items-center gap-1.5 pl-2 pr-3 py-1.5 bg-primary text-on-primary rounded-md">
        <span class="material-symbols-outlined icon-filled" style="font-size:18px">shield_person</span>
        <span class="text-rotulo">Tu reputación</span>
      </div>
      <h2 class="text-headline-lg-mobile md:text-headline-lg text-ink">
        Tu reputación se gana ayudando
      </h2>
      <p class="text-body-lg text-on-surface-variant">
        Cada vez que cumples, tus vecinos te dejan estrellas. Con buenas reseñas, la comunidad te fía más.
      </p>
      <ul class="space-y-4 pt-2">
        <li class="flex items-start gap-3">
          <span class="w-9 h-9 rounded-md bg-primary-fixed text-primary grid place-items-center shrink-0"><span class="material-symbols-outlined icon-filled" style="font-size:20px">star</span></span>
          <div>
            <h4 class="text-label-md text-on-surface">Reseñas de ida y vuelta</h4>
            <p class="text-body-md text-on-surface-variant">
              Después de cada intercambio, los dos se evalúan.
            </p>
          </div>
        </li>
        <li class="flex items-start gap-3">
          <span class="w-9 h-9 rounded-md bg-secondary-fixed text-on-secondary-fixed-variant grid place-items-center shrink-0"><span class="material-symbols-outlined icon-filled" style="font-size:20px">trending_up</span></span>
          <div>
            <h4 class="text-label-md text-on-surface">Subes de nivel</h4>
            <p class="text-body-md text-on-surface-variant">
              Mientras más cumples, más te fía la comunidad.
            </p>
          </div>
        </li>
        <li class="flex items-start gap-3">
          <span class="w-9 h-9 rounded-md bg-tertiary-fixed text-tertiary grid place-items-center shrink-0"><span class="material-symbols-outlined icon-filled" style="font-size:20px">location_on</span></span>
          <div>
            <h4 class="text-label-md text-on-surface">Cuenta tu barrio</h4>
            <p class="text-body-md text-on-surface-variant">
              Tu reputación crece donde vives y te mueves.
            </p>
          </div>
        </li>
      </ul>
    </div>
  </div>
</section>

<%# CTA final %>
<section class="px-margin-mobile md:px-margin-desktop max-w-[1280px] mx-auto pb-20">
  <div class="franja rounded-xl px-6 py-10 md:px-16 md:py-14 text-center md:text-left md:flex md:items-center md:justify-between gap-8 border-b-[6px] border-signal">
    <div class="max-w-2xl">
      <h2 class="text-headline-lg-mobile md:text-headline-lg text-on-primary mb-3">
        Únete gratis
      </h2>
      <p class="text-body-md text-on-primary-container">
        Mira qué ofrecen cerca de ti y haz tu primer intercambio.
      </p>
    </div>
    <div class="flex flex-col sm:flex-row gap-3 justify-center mt-6 md:mt-0 shrink-0">
      <%= link_to "Crear cuenta", signup_path,
            class: "bg-signal text-ink hover:bg-secondary-fixed px-7 min-h-12 inline-flex items-center justify-center rounded-full text-label-md transition-colors" %>
      <%= link_to "Ingresar", new_session_path,
            class: "border-2 border-on-primary text-on-primary px-7 min-h-12 inline-flex items-center justify-center rounded-full text-label-md hover:bg-primary-strong transition-colors" %>
    </div>
  </div>
</section>
