<% content_for :title, "Cómo funciona — Confianza" %>
<% content_for :head do %>
  <%= seo_meta_tags(
        title:       "Cómo funciona",
        description: "Guía rápida de Confianza: publica, interactúa, evalúa y decide. La reputación se construye con hechos, los recursos circulan con créditos comunitarios y las reglas las vota la comunidad.",
        canonical:   how_it_works_url) %>
<% end %>
<%
  # El recorrido, como las estaciones de una línea: cada paso en una o dos frases.
  pasos = [
    [ "add_circle",  "bg-secondary text-on-secondary",              "Publica",                 "Cuenta qué ofreces o qué necesitas.", "Tus vecinos lo ven en el mapa." ],
    [ "forum",       "bg-primary text-on-primary",                  "Ponte de acuerdo",        "Alguien te pide algo, o tú pides.",    "Conversan y acuerdan cuántos créditos." ],
    [ "handshake",   "bg-primary text-on-primary",                  "Cierra el intercambio",   "Cuando está hecho, los dos lo confirman.", "Ahí se mueven los créditos." ],
    [ "star",        "bg-tertiary text-on-tertiary",                "Deja tu reseña",          "Se evalúan con estrellas.",            "Así todos saben en quién confiar." ],
    [ "how_to_vote", "bg-primary-container text-on-primary",        "Decide con tu barrio",    "Cada intercambio deja un poquito para el barrio.", "Los vecinos votan en qué usarlo." ]
  ]
  creditos_simple = [
    [ "flag",      "Empiezas con 0 C. Todos parten igual." ],
    [ "handshake", "Si te falta, la comunidad te fía." ],
    [ "savings",   "Ganas créditos cuando ayudas o vendes algo." ],
    [ "groups",    "Nadie puede juntar más que otra persona." ]
  ]
  no_es = [
    [ "currency_bitcoin", "No es cripto",           "Los créditos no se compran ni se venden." ],
    [ "account_balance",  "No es un banco",         "No presta dinero ni cobra comisiones." ],
    [ "thumb_up",         "No es una red de likes", "Lo que vale es lo que haces." ]
  ]
%>

<%# Hero %>
<section class="pt-12 pb-10 md:pt-20 md:pb-14 px-margin-mobile md:px-margin-desktop max-w-[1280px] mx-auto">
  <div class="max-w-2xl mx-auto text-center space-y-5">
    <div class="inline-flex items-center gap-1.5 pl-2 pr-3 py-1.5 bg-primary text-on-primary rounded-md">
      <span class="material-symbols-outlined icon-filled" style="font-size:18px">menu_book</span>
      <span class="text-rotulo">Guía rápida</span>
    </div>
    <h1 class="text-headline-lg-mobile md:text-headline-xl text-ink">
      Cómo funciona Confianza
    </h1>
    <p class="text-body-lg text-on-surface-variant">
      Vecinos que intercambian cosas y ayuda, con créditos en vez de dinero.
    </p>
  </div>
</section>

<%# El recorrido: una línea con estaciones %>
<section class="bg-surface-container-low border-y border-outline-variant/60 py-12 md:py-16 px-margin-mobile md:px-margin-desktop">
  <div class="max-w-2xl mx-auto">
    <h2 class="text-headline-md text-on-surface mb-6">Así se usa</h2>
    <div class="relative">
    <span class="absolute left-[22px] top-6 bottom-6 w-1 bg-primary/30 rounded-full" aria-hidden="true"></span>
    <ol class="relative space-y-4">
      <% pasos.each_with_index do |(icono, color, titulo, frase1, frase2), i| %>
        <li class="relative flex items-start gap-4">
          <span class="relative z-10 w-12 h-12 rounded-lg <%= color %> grid place-items-center shrink-0 ambient-shadow">
            <span class="material-symbols-outlined icon-filled" style="font-size:24px"><%= icono %></span>
          </span>
          <div class="flex-1 rounded-xl bg-surface-container-lowest border border-outline-variant/60 ambient-shadow p-4">
            <p class="text-rotulo text-on-surface-variant">Paso <%= i + 1 %></p>
            <h3 class="text-headline-sm text-on-surface"><%= titulo %></h3>
            <p class="text-body-md text-on-surface-variant mt-1"><%= frase1 %> <%= frase2 %></p>
          </div>
        </li>
      <% end %>
    </ol>
    </div>
  </div>
</section>

<%# Los créditos, en cuatro frases %>
<section class="py-12 md:py-16 px-margin-mobile md:px-margin-desktop">
  <div class="max-w-2xl mx-auto space-y-5">
    <h2 class="text-headline-md text-on-surface">¿Y los créditos?</h2>
    <ul class="space-y-3">
      <% creditos_simple.each do |icono, frase| %>
        <li class="flex items-center gap-3">
          <span class="w-10 h-10 rounded-lg bg-primary-fixed text-primary grid place-items-center shrink-0">
            <span class="material-symbols-outlined icon-filled" style="font-size:22px"><%= icono %></span>
          </span>
          <span class="text-body-lg text-on-surface"><%= frase %></span>
        </li>
      <% end %>
    </ul>
    <%= link_to economics_path,
          class: "inline-flex items-center gap-1.5 min-h-11 text-label-md text-primary hover:underline underline-offset-4" do %>
      Ver las reglas de los créditos
      <span class="material-symbols-outlined" style="font-size:18px">arrow_forward</span>
    <% end %>
  </div>
</section>

<%# Lo que no es %>
<section class="pb-12 md:pb-16 px-margin-mobile md:px-margin-desktop">
  <div class="max-w-4xl mx-auto space-y-5">
    <h2 class="text-headline-md text-on-surface max-w-2xl mx-auto">Lo que <em>no</em> es Confianza</h2>
    <ul class="grid grid-cols-1 md:grid-cols-3 gap-3">
      <% no_es.each do |icono, titulo, frase| %>
        <li class="bg-surface-container-lowest rounded-xl p-4 ambient-shadow border border-outline-variant/60 flex items-start gap-3">
          <span class="w-10 h-10 rounded-lg bg-error-container text-on-error-container grid place-items-center shrink-0">
            <span class="material-symbols-outlined" style="font-size:22px"><%= icono %></span>
          </span>
          <span>
            <span class="block text-label-md text-on-surface"><%= titulo %></span>
            <span class="block text-body-md text-on-surface-variant"><%= frase %></span>
          </span>
        </li>
      <% end %>
    </ul>
  </div>
</section>

<%# CTA final %>
<section class="px-margin-mobile md:px-margin-desktop max-w-[1280px] mx-auto pb-16">
  <div class="franja rounded-xl px-6 py-10 md:px-16 md:py-14 text-center border-b-[6px] border-signal">
    <h2 class="text-headline-lg-mobile md:text-headline-lg text-on-primary mb-3">
      ¿Listo para unirte?
    </h2>
    <p class="text-body-md text-on-primary-container max-w-2xl mx-auto mb-8">
      Crear una cuenta toma un minuto.
    </p>
    <div class="flex flex-col sm:flex-row gap-3 justify-center">
      <%= link_to "Crear cuenta", signup_path,
            class: "bg-signal text-ink hover:bg-secondary-fixed px-7 min-h-12 inline-flex items-center justify-center rounded-full text-label-md transition-colors" %>
      <%= link_to "Ingresar", new_session_path,
            class: "border-2 border-on-primary text-on-primary px-7 min-h-12 inline-flex items-center justify-center rounded-full text-label-md hover:bg-primary-strong transition-colors" %>
    </div>
  </div>
</section>
