<%# Dos tarjetas para quien ya entró: armar su vitrina (si no la tiene) e
    invitar gente. En una red que recién parte, esto es lo que la hace crecer. %>
<% yo = Current.session.user %>
<div class="grid grid-cols-1 md:grid-cols-2 gap-4">
  <% unless yo.showcase? %>
    <div class="rounded-xl bg-primary-fixed/60 border border-primary-fixed-dim p-4 space-y-2.5">
      <p class="text-label-md text-on-surface flex items-center gap-1.5">
        <span class="material-symbols-outlined icon-filled text-primary" style="font-size:18px">storefront</span>
        ¿Ofreces algo? Crea tu vitrina
      </p>
      <p class="text-caption text-on-surface-variant">
        Tu página con WhatsApp, horario, servicios y reseñas — un link para tu
        Instagram y un QR para tu local. Gratis, en dos minutos.
      </p>
      <%= link_to onboarding_vitrina_path,
            class: "inline-flex items-center gap-1.5 px-5 min-h-11 rounded-full bg-primary text-on-primary text-label-md hover:bg-primary-strong transition-colors" do %>
        <span class="material-symbols-outlined" style="font-size:16px">rocket_launch</span>
        Crear mi vitrina
      <% end %>
    </div>
  <% end %>

  <div class="rounded-xl bg-surface-container-lowest border border-outline-variant/60 ambient-shadow p-4 space-y-2.5">
    <p class="text-label-md text-on-surface flex items-center gap-1.5">
      <span class="material-symbols-outlined icon-filled text-primary" style="font-size:18px">handshake</span>
      Trae a tu gásfiter, tu almacén, tu vecina que cose
    </p>
    <p class="text-caption text-on-surface-variant">
      La red sirve cuando está la gente que ya conoces. Quien se registre con tu
      link queda apadrinado por ti y parte con un colchón extra de crédito.
    </p>
    <%= render "shared/share_button",
          url:   invite_url(code: yo.username),
          title: "Únete a Confianza",
          text:  "Te invito a Confianza, la red de confianza del barrio: servicios y productos entre vecinos, con reseñas reales. Entra con mi link:" %>
  </div>
</div>
