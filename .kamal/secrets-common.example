# Plantilla — copiar a .kamal/secrets-common (gitignored) y completar.
#
# Sintaxis: dotenv simple (KEY=value, sin export, sin comillas si no hay
# espacios). NO es bash. Kamal lo parsea con la gema dotenv.
#
# El PAT classic se crea en https://github.com/settings/tokens con scopes
# write:packages, read:packages, delete:packages.
#
# El password de la DB: generar con `openssl rand -base64 32 | tr -d '/+='`.

KAMAL_REGISTRY_PASSWORD=ghp_TU_TOKEN_AQUI
CONFIANZA_DATABASE_PASSWORD=cambialo_por_uno_random_largo
# Mismo valor que CONFIANZA_DATABASE_PASSWORD — la app y postgres
# tienen que coincidir.
POSTGRES_PASSWORD=cambialo_por_uno_random_largo

# Correo que recibe las alertas de errores y del ledger (y contacto para Nominatim).
ALERT_EMAIL=alertas@tu-dominio.example
